# Application mobile Tamurt Events (Expo). Copiez en .env.local (jamais committé).
# Valeurs PUBLIQUES uniquement : elles sont intégrées à l'application.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL du site web (API REST /api/v1). Sur un téléphone physique, utilisez l'IP de votre ordinateur.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
EXPO_PUBLIC_APP_ENV=development
# Domaine du site pour les liens universels (ex. tamurt.events). Facultatif.
EXPO_PUBLIC_WEB_HOST=
# Style de carte (OpenFreeMap, sans clé) — utilisé pour les liens « ouvrir dans le navigateur ».
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Variables de CONSTRUCTION (EAS) — à définir comme variables d'environnement EAS, jamais ici :
# IOS_BUNDLE_ID, ANDROID_PACKAGE, EAS_PROJECT_ID, EXPO_OWNER, GOOGLE_MAPS_ANDROID_API_KEY
