# ---------------------------------------------------------------------------
# Tamurt Events — site web (Next.js). Copiez en .env.local (jamais committé).
# En local, `pnpm setup:local` remplit automatiquement les valeurs Supabase.
# ---------------------------------------------------------------------------

# URL publique du site (liens des e-mails, SEO, OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (clé publique « anon » / publishable : sans risque côté navigateur, protégée par la RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé SERVEUR (service role / secret) : ne jamais exposer au navigateur ni committer
SUPABASE_SERVICE_ROLE_KEY=

# Secret serveur (≥ 32 caractères) : codes d'invitation, références titulaires. Obligatoire en production.
TAMURT_SERVER_SECRET=

# Protection des routes de tâches planifiées (Vercel Cron envoie "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Fournisseur fictif : secret de signature des webhooks de démonstration
DEMO_PROVIDER_WEBHOOK_SECRET=

# Connecteurs de billetterie RÉELS activés explicitement (vide = aucun). Ex. : ticketmaster
TICKETING_LIVE_PROVIDERS=

# E-mails applicatifs (bêta, notifications). Local : Mailpit de Supabase (127.0.0.1:54325).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Tamurt Events <no-reply@example.com>"
# Liste blanche facultative (prévisualisations / bêta) : domaines ou adresses séparés par des virgules
EMAIL_ALLOWLIST=

# Notifications push (Expo). Désactivées par défaut.
PUSH_NOTIFICATIONS_ENABLED=false
EXPO_ACCESS_TOKEN=

# Géocodage Nominatim (OpenStreetMap) : contact obligatoire selon la politique d'usage. Vide = désactivé.
GEOCODING_CONTACT_EMAIL=

# Contact support affiché sur le site (facultatif)
NEXT_PUBLIC_SUPPORT_EMAIL=

# Tuiles cartographiques (OpenFreeMap, gratuit, sans clé)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Adresse de Tamurt Services, la maison mère (facultatif). Renseignée, elle affiche le bouton yaz
# rouge en haut à droite de l'en-tête, qui ramène à toutes les applications Tamurt. Vide : pas de bouton.
TAMURT_SERVICES_URL=
