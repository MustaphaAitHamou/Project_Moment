{
  "name": "@tamurt/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Internationalisation : langues (fr, en, ar RTL), catalogues ICU partagés web/mobile, architecture prête pour le tamazight.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./messages/*.json": "./src/messages/*.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@tamurt/core": "workspace:*"
  },
  "devDependencies": {
    "@tamurt/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "react": "catalog:",
    "typescript": "catalog:",
    "use-intl": "catalog:",
    "vitest": "catalog:"
  }
}
