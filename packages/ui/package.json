{
  "name": "@tamurt/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Design system Tamurt Events : tokens (couleurs, typographie, espacements, mouvements), identité visuelle et affiches génératives, partagés web/mobile.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./generated/tokens.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:css": "tsx scripts/build-css.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tamurt/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
