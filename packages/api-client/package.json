{
  "name": "@tamurt/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Accès aux données partagé web/mobile : requêtes Supabase typées (RLS) et client REST de l'API Tamurt.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@supabase/supabase-js": "catalog:",
    "@tamurt/core": "workspace:*",
    "@tamurt/types": "workspace:*",
    "@tamurt/validation": "workspace:*"
  },
  "devDependencies": {
    "@tamurt/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
