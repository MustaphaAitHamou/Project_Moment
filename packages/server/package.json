{
  "name": "@tamurt/server",
  "version": "0.1.0",
  "private": true,
  "description": "Services serveur (exécutés uniquement côté serveur) : billetterie, revente, bêta, notifications, géocodage, maintenance. Utilisés par les routes API du web pour le web ET le mobile.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@supabase/supabase-js": "catalog:",
    "@tamurt/core": "workspace:*",
    "@tamurt/i18n": "workspace:*",
    "@tamurt/payments": "workspace:*",
    "@tamurt/ticketing": "workspace:*",
    "@tamurt/types": "workspace:*",
    "@tamurt/validation": "workspace:*",
    "nodemailer": "10.5.0",
    "use-intl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tamurt/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "pg": "8.23.1",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
